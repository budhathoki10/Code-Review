# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Dev tunnel hostname (no https://, no trailing slash) — only needed when testing
# through a tunnel (ngrok, TryCloudflare, etc.) instead of localhost. Leave unset
# otherwise. See next.config.ts's allowedDevOrigins comment.
DEV_TUNNEL_ORIGIN=

# GitHub App — OAuth (Sign in with GitHub)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# GitHub App — server-to-server (installation tokens)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# The app's URL slug, not its display name — the last path segment of
# github.com/apps/<slug>. Used only as a fallback: the install link prefers the
# slug GitHub reports for GITHUB_APP_ID, and normalizes this one if it is set
# to a display name ("My App" -> "my-app").
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# MongoDB
MONGODB_URI=
MONGODB_DB=ai_code_review

# Redis (BullMQ job queue — used by both the webhook producer and the worker)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info

# Rate limiting (Phase 6)
WEBHOOK_RATE_LIMIT_MAX=20
WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
# AI_RATE_LIMIT_MAX counts review jobs started, not raw provider calls: each
# job can make up to 5 NVIDIA calls now (the findings side is a bounded
# tool-calling loop of up to 4 rounds, run concurrently with 1 verdict call),
# so the effective provider call rate can reach 5x this value per
# AI_RATE_LIMIT_DURATION_MS in the worst case (most reviews use far fewer).
# If tuning against a provider-side RPM cap, divide the target RPM by 5 first.
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_DURATION_MS=60000

# Per-PR review serialization — prevents two pushes to the same PR from
# being reviewed concurrently, which would race the incremental-diff logic's
# "find the last completed review" lookup. TTL is a ceiling for a crashed
# holder (the lock renews itself while a review is genuinely still running);
# RETRY_DELAY is how long a blocked job waits before checking again.
PR_REVIEW_LOCK_TTL_MS=300000
PR_REVIEW_LOCK_RETRY_DELAY_MS=3000

# Per-PR review throttle — at most one review is triggered per PR per this
# window; pushes landing inside an already-open window are debounced to a
# single review of whichever commit is HEAD once the window ends.
PR_REVIEW_THROTTLE_WINDOW_MS=60000

# NVIDIA NIM (OpenAI-compatible chat completions API)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_TEMPERATURE=0.7
NVIDIA_TOP_P=0.95
NVIDIA_MAX_TOKENS=4096
# Max ms the AI call waits for static analysis to finish before proceeding
# without its findings as context (see pipeline.ts's bounded race). A slow
# static-analysis run still contributes to the final posted findings list —
# this only bounds how long the AI call's own context-gathering can stall for.
STATIC_ANALYSIS_CONTEXT_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Everything below is optional — the code has working defaults for all of it.
# Listed here because it was previously read by the code but documented
# nowhere. Defaults shown are the ones in the source.
# ---------------------------------------------------------------------------

# Review sizing. REVIEW_CAPACITY (what one review can put in front of the
# model) is derived: MAX_REVIEW_CHUNKS x 40 files x 100,000 chars.
MAX_REVIEW_CHUNKS=4
REVIEW_CHUNK_CONCURRENCY=2
# Extra findings-loop attempts one review may spend bisecting failed chunks,
# shared across every chunk. Bounded because the failure being retried is not
# always one bad file: a provider outage fails every sub-chunk, and unbudgeted
# halving would then walk the entire tree.
REVIEW_MAX_BISECT_ATTEMPTS=12

# Size gate. Coverage is measured on both dimensions the packer bounds and
# gated separately: a file never reached is a lie about what was reviewed,
# while a file opened and truncated is a disclosable limitation.
REVIEW_MIN_COVERAGE=0.5
REVIEW_MIN_CHAR_COVERAGE=0.1
# Projected token spend, estimated from chunk sizes BEFORE any call is made.
REVIEW_MAX_ESTIMATED_TOKENS=250000
REVIEW_COST_WARN_RATIO=0.6
# Logs a warning when a single review's actual spend exceeds this. Does not
# stop anything — the gate above is what prevents spend.
REVIEW_TOKEN_CEILING=300000

# Posting limits. Findings past the inline cap move to a collapsed section of
# the summary comment rather than being dropped.
MAX_INLINE_COMMENTS=25
# Reconstructing a patch locally when GitHub returns none.
MAX_GENERATED_PATCH_CHARS=60000
MAX_PATCH_FALLBACKS=20

# Cost reporting. Both default to 0, which makes estimateCost() return 0 —
# set them to your provider's real per-million-token prices for real numbers.
AI_INPUT_COST_PER_MTOK=
AI_OUTPUT_COST_PER_MTOK=

# Reply/chat rate limiting — two separate stages, deliberately named apart.
#
# The door: how many questions are ACCEPTED per PR per window. Exceeding it
# means the question is never queued at all.
REPLY_ACCEPT_RATE_LIMIT_MAX=10
REPLY_ACCEPT_RATE_LIMIT_WINDOW_SECONDS=600
#
# The drain: how fast accepted reply jobs are PROCESSED (a BullMQ limiter).
# Higher than the accept limit on purpose — this is throughput, not admission.
REPLY_WORKER_RATE_LIMIT_MAX=20
REPLY_WORKER_RATE_LIMIT_DURATION_MS=60000
#
# Deprecated: REPLY_RATE_LIMIT_MAX / _WINDOW_SECONDS / _DURATION_MS. One name
# used to drive both stages while carrying different defaults in each (10 vs
# 20), so setting it moved both knobs and neither to the documented value.
# Still read as a fallback; prefer the names above.

# How long a job will wait for a GitHub rate limit to reset before giving up
# and letting BullMQ retry it later.
MAX_RATE_LIMIT_WAIT_MS=60000

# In-process cache for fetched file contents (static analysis and fetch_file
# often want the same file).
FILE_CONTENT_CACHE_ENTRIES=500
FILE_CONTENT_CACHE_BYTES=33554432

# Cron fallback that drains pending reviews (/api/cron/process-reviews).
# CRON_SECRET guards the endpoint; leave unset to disable it.
CRON_SECRET=
CRON_MAX_DURATION_MS=25000
