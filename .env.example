# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# GitHub App — OAuth (Sign in with GitHub)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# GitHub App — server-to-server (installation tokens)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# MongoDB
MONGODB_URI=
MONGODB_DB=ai_code_review

# NVIDIA NIM (OpenAI-compatible chat completions API)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_TEMPERATURE=0.7
NVIDIA_TOP_P=0.95
NVIDIA_MAX_TOKENS=4096
NVIDIA_REASONING_BUDGET=4096
